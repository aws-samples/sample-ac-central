{
  "name": "publish-gate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Publication gate for the 16 In_Scope_Pages - validates route comparison, audit reconciliation, command validation, and semantic review",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "fast-check": "^3.15.0",
    "typescript": "~5.5.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0"
  }
}
