{
  "name": "publish-gate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Publication gate for the 16 In_Scope_Pages - validates route comparison, audit reconciliation, command validation, and semantic review",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "fast-check": "^4.10.2",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18.0"
  }
}
